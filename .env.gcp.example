# =====================================================================
# nanoclaw — GCP deployment environment variables (TEMPLATE)
# =====================================================================
#
# DO NOT commit a populated copy of this file. The real secrets must
# live in Google Secret Manager (see gcp/README.md) and are pulled into
# the VM at boot by gcp/startup-script.sh.
#
# This file documents WHICH variables must exist; values stay empty.
# =====================================================================

# ---- Discord ----
# Bot token from https://discord.com/developers/applications
# Required intents: GUILDS, GUILD_VOICE_STATES, GUILD_MESSAGES,
# MESSAGE_CONTENT, DIRECT_MESSAGES.
DISCORD_BOT_TOKEN=

# Discord application (client) ID — used by the /wake slash command + voice
DISCORD_APPLICATION_ID=

# Comma-separated Discord guild IDs the /wake command is registered against.
# Leave blank to register globally (slower propagation).
DISCORD_GUILD_IDS=

# ---- OpenAI ----
# Used for Whisper STT and TTS (voice=nova) in src/voice/*.
# Recommended: store in Secret Manager, NOT here.
OPENAI_API_KEY=

# ---- Anthropic / Claude ----
# Optional: only required if running Claude-powered agents inside the
# nanoclaw container.
ANTHROPIC_API_KEY=

# ---- GitHub (per-group fallback) ----
# Top-level fallback token. Per-thread tokens override this via
# groups/<thread>/.env (see HANDOFF.md for `register-thread-token.sh`).
GH_TOKEN=

# ---- Admin allowlist ----
# Comma-separated Discord user IDs that may invoke /wake, /sleep,
# and bypass the per-user GH token DM flow.
ADMIN_USER_IDS=

# ---- Wake / idle behavior (read by gcp/idle-watchdog.sh) ----
# Minutes of no active voice connection before the VM auto-stops.
# Override per-deployment in /etc/nanoclaw/idle.env on the VM.
IDLE_STOP_MINUTES=15

# ---- Tailscale (optional, for SSH without public IP) ----
# Auth key from https://login.tailscale.com/admin/settings/keys
# Use an ephemeral, pre-approved, reusable key for the VM.
TAILSCALE_AUTH_KEY=
